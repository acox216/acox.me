/**
 * Cloudflare Workers config for deploying the Astro build.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * `main` points at the adapter's server entrypoint. Blog routes render
 * on-demand (export const prerender = false) and fetch from Ghost; the rest of
 * the site is prerendered into ./dist/client and served as static assets.
 *
 * Secrets (set with `wrangler secret put NAME`, not stored here):
 *   GHOST_CONTENT_API_KEY, CF_ACCESS_CLIENT_ID, CF_ACCESS_CLIENT_SECRET
 *
 * Deploy:  npm run build && npx wrangler deploy
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "acoxme",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-04-15",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"preview_urls": false,
	// Non-secret config. The Ghost Content API key + CF Access service token are
	// secrets (wrangler secret put / dashboard), not stored here.
	"vars": {
		"GHOST_URL": "https://cms.acox.dev"
	},
	/**
	 * Bindings the @astrojs/cloudflare adapter expects. Pinning them here stops
	 * wrangler from auto-provisioning (and re-creating) them on every deploy.
	 */
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "95453ba72c544b7e8cf36541199ba181"
		}
	],
	// Cloudflare Images binding for Astro's image service (no id needed).
	"images": {
		"binding": "IMAGES"
	}
}
