---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { config } from "../config";
import Wallpaper from "../components/Wallpaper.astro";

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	/** render the desktop wallpaper behind the page (default true) */
	showWallpaper?: boolean;
	/** lay out as a fixed, non-scrolling "desktop" (homepage) vs a normal
	 * scrolling document (blog) */
	desktop?: boolean;
}

const {
	title = config.name,
	description = config.description,
	ogImage,
	showWallpaper = true,
	desktop = false,
} = Astro.props;

const wpBase = "base" in config.wallpaper ? config.wallpaper.base : "#0b0e14";
// Theme custom properties injected at build time.
const rootVars = `:root{--accent:${config.accent};--bg:${wpBase};}`;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="canonical" href={canonical} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={config.name}
			href="/rss.xml"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<style set:html={rootVars}></style>
		<ClientRouter />
	</head>
	<body class:list={{ "is-desktop": desktop }}>
		{showWallpaper && <Wallpaper />}
		<slot />
	</body>
</html>
