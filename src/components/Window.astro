---
import { config, linkIsExternal } from "../config";
import { icons } from "../icons";
---

<main class="card" data-window="profile">
	<div class="bar" data-drag-handle>
		<span class="dot r"></span><span class="dot y"></span><span class="dot g"
		></span>
		<span class="path">{config.windowPath}</span>
	</div>
	<div class="body">
		<div class="head">
			<img class="avatar" src={config.avatar} alt={config.name} />
			<div>
				<h1>{config.greeting}<span class="cursor" aria-hidden="true">_</span></h1>
				<div class="subtitle">{config.subtitle}</div>
			</div>
		</div>

		{
			config.bio.map((line) => (
				<p class:list={["bio", { dim: line.dim }]}>
					<span class="prompt">&gt;</span> {line.text}
				</p>
			))
		}

		<nav class="links">
			{
				config.links.map((link) => (
					<a
						href={link.url}
						target={linkIsExternal(link) ? "_blank" : undefined}
						rel={linkIsExternal(link) ? "noopener" : undefined}
					>
						{link.icon && <Fragment set:html={icons[link.icon]} />}
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
</main>

<script>
	import { initDraggable } from "../scripts/draggable";
	// Runs on first load and after every client-side navigation (the window is
	// recreated when returning to the homepage).
	document.addEventListener("astro:page-load", initDraggable);
</script>
