---
import { config, isDropdownMenu, linkIsExternal, type LinkItem } from "../config";
import { icons } from "../icons";

// A LinkMenu is structurally assignable to LinkItem (icon optional), so the
// flattened list is uniformly LinkItem[] — no per-item narrowing needed.
const allLinks: LinkItem[] = config.menus.flatMap((menu) =>
	isDropdownMenu(menu) ? menu.items : [menu]
);
---

<div class="menubar" id="menubar" transition:persist="menubar">
	<a class="brand" href="/" aria-label={config.name}>
		<span class="mark">ac</span><span class="underscore">_</span>
	</a>
	<div class="menus">
		{
			config.menus.map((menu, i) =>
				isDropdownMenu(menu) ? (
					<div class="menu" data-menu={i}>
						<button type="button">{menu.label}</button>
						<div class="dropdown">
							{menu.items.map((item) => (
								<a
									href={item.url}
									target={linkIsExternal(item) ? "_blank" : undefined}
									rel={linkIsExternal(item) ? "noopener" : undefined}
								>
									{item.icon && <Fragment set:html={icons[item.icon]} />}
									<span>{item.label}</span>
								</a>
							))}
						</div>
					</div>
				) : (
					<a
						class="menu-link"
						href={menu.url}
						target={linkIsExternal(menu) ? "_blank" : undefined}
						rel={linkIsExternal(menu) ? "noopener" : undefined}
					>
						{menu.label}
					</a>
				)
			)
		}
	</div>
	<button type="button" class="mobile-menu-btn" id="mobile-menu-btn">Menu</button>
	<div class="mobile-dropdown" id="mobile-dropdown">
		{
			allLinks.map((item) => (
				<a
					href={item.url}
					target={linkIsExternal(item) ? "_blank" : undefined}
					rel={linkIsExternal(item) ? "noopener" : undefined}
				>
					{item.icon && <Fragment set:html={icons[item.icon]} />}
					<span>{item.label}</span>
				</a>
			))
		}
	</div>
	<div class="clock" id="clock"></div>
</div>

<script>
	// --- dropdown toggle ---
	const buttons = document.querySelectorAll<HTMLButtonElement>(
		".menubar .menu > button"
	);
	buttons.forEach((btn) => {
		btn.addEventListener("click", (e) => {
			e.stopPropagation();
			const menu = btn.parentElement!;
			const isOpen = menu.classList.contains("open");
			document
				.querySelectorAll(".menubar .menu.open")
				.forEach((m) => m.classList.remove("open"));
			if (!isOpen) menu.classList.add("open");
		});
	});
	document.addEventListener("click", () =>
		document
			.querySelectorAll(".menubar .menu.open")
			.forEach((m) => m.classList.remove("open"))
	);

	// --- mobile menu toggle ---
	const mobileBtn = document.getElementById("mobile-menu-btn");
	const mobileDropdown = document.getElementById("mobile-dropdown");
	mobileBtn?.addEventListener("click", (e) => {
		e.stopPropagation();
		const isOpen = mobileDropdown?.classList.toggle("open");
		mobileBtn.classList.toggle("open", isOpen);
	});
	document.addEventListener("click", () => {
		mobileDropdown?.classList.remove("open");
		mobileBtn?.classList.remove("open");
	});

	// --- live clock ---
	const clock = document.getElementById("clock");
	if (clock) {
		const tick = () => {
			const d = new Date();
			const day = d.toLocaleDateString(undefined, {
				weekday: "short",
				month: "short",
				day: "numeric",
			});
			const time = d.toLocaleTimeString(undefined, {
				hour: "numeric",
				minute: "2-digit",
			});
			clock.textContent = `${day}  ${time}`;
		};
		tick();
		setInterval(tick, 15000);
	}
</script>
