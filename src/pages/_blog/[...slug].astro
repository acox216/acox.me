---
export const prerender = false;

import { render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import { getPost } from "../../lib/posts";

const { slug = "" } = Astro.params;
const post = slug ? await getPost(slug) : null;

if (!post) {
	return new Response("Post not found", { status: 404 });
}

// MDX posts render via Astro's <Content/>; Ghost posts are pre-rendered HTML.
let Content: Awaited<ReturnType<typeof render>>["Content"] | null = null;
if (post.source === "mdx") {
	Content = (await render(post.entry)).Content;
}

const { meta } = post;
---

<BlogPost
	title={meta.title}
	description={meta.excerpt}
	pubDate={meta.date}
	updatedDate={meta.updatedDate}
	tags={meta.tags}
	heroImage={meta.heroImage}
>
	{post.source === "mdx" && Content && <Content />}
	{post.source === "ghost" && <Fragment set:html={post.html} />}
</BlogPost>
