---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import MenuBar from "../../components/MenuBar.astro";
import { getAllPosts } from "../../lib/posts";

const posts = await getAllPosts();

const fmt = (d: Date) =>
	d.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
---

<Base title="Blog — Alex Cox" description="Notes on what I'm building.">
	<MenuBar />

	<main class="blog-index">
		<a class="back" href="/">← Home</a>
		<h1>Blog</h1>
		<p class="lead">Notes on what I'm building.</p>

		{
			posts.length === 0 ? (
				<p class="empty">No posts yet. Check back soon.</p>
			) : (
				<ul class="posts">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.slug}`}>
								<time datetime={post.date.toISOString()}>
									{fmt(post.date)}
								</time>
								<span class="title">{post.title}</span>
								<span class="desc">{post.excerpt}</span>
								{post.tags.length > 0 && (
									<span class="tags">
										{post.tags.map((t) => (
											<span class="tag">#{t}</span>
										))}
									</span>
								)}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</main>
</Base>

<style>
	.blog-index {
		max-width: 720px;
		margin: 0 auto;
		padding: calc(var(--menubar-h) + 2.5rem) 1.5rem 4rem;
	}

	.back {
		display: inline-block;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.82rem;
		color: var(--muted);
		text-decoration: none;
		margin-bottom: 1.75rem;
	}
	.back:hover {
		color: var(--accent);
	}

	h1 {
		font-family: "JetBrains Mono", monospace;
		font-size: 2rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.lead {
		color: var(--muted);
		margin-top: 0.4rem;
		margin-bottom: 2.5rem;
	}

	.posts {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.posts a {
		display: grid;
		gap: 0.3rem;
		text-decoration: none;
		color: var(--text);
		background: rgba(13, 17, 23, 0.55);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 1.1rem 1.25rem;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}
	.posts a:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}

	.posts time {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.74rem;
		color: var(--muted);
	}

	.posts .title {
		font-family: "JetBrains Mono", monospace;
		font-size: 1.1rem;
		font-weight: 700;
	}

	.posts .desc {
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.5;
	}

	.posts .tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.4rem;
	}
	.posts .tag {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.7rem;
		color: var(--accent);
	}

	.empty {
		color: var(--muted);
	}
</style>
